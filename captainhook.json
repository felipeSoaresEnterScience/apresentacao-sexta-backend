{
    "config": {
        "git-directory": ".git",
        "fail-on-first-error": true,
        "run-mode": "docker",
        "run-exec": "sh bin/captainhook-docker.sh",
        "bootstrap": ""
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "php ./vendor/bin/pint --dirty",
                "options": [],
                "conditions": []
            },
            {
                "action": "php -d memory_limit=1G ./vendor/bin/phpstan analyse --no-progress",
                "options": [],
                "conditions": []
            }
        ]
    },
    "pre-push": {
        "enabled": true,
        "actions": [
            {
                "action": "sh bin/validate-pre-push.sh",
                "options": [],
                "conditions": []
            }
        ]
    },
    "commit-msg": {
        "enabled": true,
        "actions": [
            {
                "action": "sh bin/validate-commit-msg.sh {$FILE}",
                "options": [],
                "conditions": []
            }
        ]
    }
}
